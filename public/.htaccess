# Сайт статичный: несуществующие адреса отдают честную страницу 404,
# а не главную (иначе поисковики видят «мягкие» 404 и дубли главной).
ErrorDocument 404 /404.html
 
# Служебный файл с токеном бота нельзя открыть из браузера
<Files "secrets.php">
  Order allow,deny
  Deny from all
</Files>
 
# Кэш в браузере.
# HTML-страницы: браузер каждый раз сверяется с сервером (если страница не менялась,
# сервер отвечает коротким «не изменилось»). Так посетители сразу видят новую версию сайта.
# Стили, скрипты и картинки хранятся в браузере сутки. Стили и скрипты подключены
# с ?v=…, поэтому после правки достаточно поменять v — браузер скачает новый файл сразу.
<IfModule mod_headers.c>
  <FilesMatch "\.(html?|php)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js|jpe?g|png|svg|ico|webp|woff2?)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>
 
